{
    "buildFlags": {
        "VERSION": "1.0.0"
    },
    "src": {
        "../../eeditor/engine/": [
            "3rdparty/es6-shim.js",
            "3rdparty/bowser.js",
            "3rdparty/howler.core.js",
            "globals.js",
            "bus.js",
            "wfont.js",
            "basicTypes.js",
            "renderer.js",
            "object3d.js",
            "camera.js",
            "events.js",
            "sound.js",
            "node.js",
            "engine.js",
            "tweens.js",
            "html.js",
            "particles.js",
            "loadtasks.js",
            "localization.js",
            "text.js",
            "shadow.js",
            "windows.js"
        ],
        "src/": [
            "util/math2d.js",
            "util/Queue.js",
            "util/list.js",
            "util/format.js",
            "util/nulls.js",

            "core/input/Axis.js",
            "core/input/Input.js",
            "core/GameConfig.js",
            "core/G.js",
            "core/gameLoop.js",
            "core/Presenter.js",
            "core/E.js",

            "services/TurnManager.js",
            "services/WindowManager.js",

            "content/level/entities/EntityState.js",
            "content/level/entities/GameEntity.js",
            "content/level/entities/Player.js",
            "content/level/entities/Sweeper.js",
            "content/level/room/Room.js",
            "content/level/room/RoomNode.js",
            "content/level/room/RoomMatch.js",
            "content/level/room/RoomAsset.js",
            "content/level/room/RoomTile.js",
            "content/level/room/Door.js",
            "content/level/room/SpawnPoint.js",
            "content/level/LevelGenerator.js",
            "content/level/Level.js",
            "content/level/LevelType.js",

            "content/items/Inventory.js",
            "content/items/Item.js",
            "content/items/ItemAsset.js",
            "content/items/BandageItem.js",

            "registry/Defs.js",
            "registry/RoomAssetRegistry.js",
            "registry/LevelTypeRegistry.js",
            "registry/WindowRegistry.js",
            "registry/EntityViewPrefabs.js",
            "registry/Anims.js",

            "render/Tileset.js",
            "render/StaticNodeBatch.js",
            "render/EntityView.js",
            "render/EntityViewManager.js",
            "render/LevelView.js",
            "render/GameView.js",
            "render/Gui.js",
            "render/PlayerHealthView.js",
            "render/DebugView.js",
            "render/ItemCardView.js",
            "render/TileSelectionView.js",
            "render/GameWindowManager.js",

            "bootstrap/loading.js",
            "bootstrap/contentBootstrapper.js",
            "bootstrap/main.js"
        ]
    },
    "options": {
        "__disableCache": 0,
        "__disableCacheByVer": 0,
        "__storeChildsAsObject": 1,
        "__supportedLangs": [

        ],
        "__defaultTextProperties": {
            "__fontface": "ModernDOS8x14"
        },
        "__upscaleResolution": {
            "x": 640,
            "y": 360
        },
        "__localesDir": "lang/",
        "__baseShadersFolder": "shaders/",
        "__baseLayoutsFolder": "layouts/",
        "__baseParticlesFolder": "vfx/",
        "__baseFontsFolder": "fonts/",
        "__baseConfigsFolder": "configs/",
        "__disablePacking": 1
    },
    "res": [
        [
            "locale"
        ],
        [
            "config",
            "level_types/level_type_1.json",
            "entities/player.json",
            "entities/sweeper.json",
            "rooms/combat/room_combat_1.json",
            "rooms/combat/room_combat_2.json",
            "rooms/combat/room_combat_3.json",
            "rooms/combat/room_combat_4.json",
            "rooms/exit/room_exit_1.json",
            "rooms/hub/room_hub_1.json",
            "rooms/start/room_start_1.json",
            "game.json"
        ],
        [
            "sound",
            "build_res/sounds.json"
        ],
        [
            "atlas",
            "build_res/atlas-0.png?",
            "build_res/atlas-0.json?"
        ],
        [
            "effect"
        ],
        [
            "font",
            [
                "ModernDOS8x14"
            ]
        ],
        [
            "layout",
            "entities/player.json",
            "entities/sweeper.json",
            "test_level.json",
            "gui.json",
            "inventory_window.json",
            "item_card.json"
        ],
        [
            "shaders",
            "base.f",
            "c.f",
            "base.v",
            "part.f",
            "part.v",
            "partnc.f",
            "partnc.v"
        ]
    ],
    "build_targets": {
        "SOUNDS": [
            {
                "type": "sounds",
                "description": "create sounds.json file with all sounds for howler library",
                "src": "sounds/*",
                "dst": "build_res/"
            }
        ],
        "ATLAS": [
            {
                "type": "atlas",
                "description": "create atlas file with all textures for the game",
                "name": "atlas",
                "width": 4096,
                "height": 4096,
                "src": "./img/*.*",
                "dst": "build_res/",
                "format": "short",
                "arrayFormat": 1
            }
        ],
        "PRODUCTION": [
            {
                "type": "clean",
                "description": "clean builds directory",
                "src": "builds/$VERSION/*"
            },
            {
                "type": "file",
                "description": "create opts.json file with all project options",
                "name": "opts.json",
                "dst": "build_res/",
                "content": {
                    "options": "@/options",
                    "res": "@/res",
                    "version": "$VERSION"
                }
            },
            {
                "type": "datacache",
                "description": "create data.js file with all resources",
                "src": [
                    "lang/*.json",
                    "shaders/*",
                    "layouts/**/*.json",
                    "configs/**/*.json",
                    "fonts/*.*",
                    "vfx/*",
                    "build_res/*.json",
                    "build_res/*.png",
                    "build_res/*.mp3"
                ],
                "dst": "build_res/data.js"
            },
            {
                "type": "minify",
                "description": "minify all project code into min.js file",
                "src": [
                    "@/src",
                    "build_res/data.js"
                ],
                "dst": "build_res/min.js",
                "rmdebug": "debug/undebug,3d/no3d,cheats/endcheats",
                "configuration": "release"
            },
            {
                "type": "clean",
                "description": "clean all minified files",
                "src": [
                    "min_*.js"
                ]
            },
            {
                "type": "packIntoOneFile",
                "description": "pack all project files into one index.html file",
                "dst": "builds/$VERSION/index.html",
                "sourceFile": "build_res/index.html",
                "src": {
                    "/*min.js*/": "build_res/min.js"
                }
            }
        ],
        "ALL": [
            {
                "type": "target",
                "description": "build all project targets",
                "src": [
                    "ATLAS",
                    "SOUNDS",
                    "PRODUCTION"
                ]
            }
        ]
    }
}